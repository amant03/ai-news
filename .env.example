# LLM (optional - for AI summaries)
# Install Ollama from https://ollama.ai and pull a model:
#   ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Data source for the deployed (serverless) app.
# After deploying, set this to "<your-github-username>/<repo-name>" so the
# deployed app reads the freshest committed data via raw.githubusercontent.com.
DATA_REPO=amant03/ai-news
DATA_BRANCH=main

# Required when DATA_REPO points to a PRIVATE repo (raw.githubusercontent.com
# returns 404 otherwise). Fine-grained PAT with "Contents: Read" on the data repo.
# Optional extras for the daily Vercel cron fallback:
#   - "Contents: Read and write" so it can commit news.json if Actions dispatch fails
#   - "Actions: Read and write" so it can dispatch .github/workflows/agent.yml
# Set this in Vercel project env vars for production.
# GITHUB_DATA_TOKEN=

# Agent loop interval in milliseconds (local `npm run agent:loop`). Default 4h.
AGENT_INTERVAL_MS=14400000

# Public site origin for canonical URLs, Open Graph, and sitemap.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cron secret for /api/cron (optional locally; set the same value in Vercel
# project env vars so Vercel Cron authenticates with "Bearer <CRON_SECRET>").
CRON_SECRET=

# Set to 'true' to disable X/Twitter scraping (headless browser) in the agent.
# DISABLE_X_SCRAPING=true

# Hybrid chat advisor (Phase 3) — opt-in "Ask AI" mode.
# Free-tier only: backed by local Ollama, zero API cost. Deterministic mode
# always works regardless of these settings.
# ENABLE_LLM_CHAT=true
