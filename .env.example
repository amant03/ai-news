# LLM (optional - for AI summaries)
# Install Ollama from https://ollama.ai and pull a model:
#   ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Data source for the deployed (serverless) app.
# After deploying, set this to "<your-github-username>/<repo-name>" so the
# deployed app reads the freshest committed data via raw.githubusercontent.com.
DATA_REPO=amant03/ai-news
DATA_BRANCH=main

# Agent loop interval in milliseconds (local `npm run agent:loop`). Default 4h.
AGENT_INTERVAL_MS=14400000

# Cron secret for /api/cron (optional)
CRON_SECRET=

# Set to 'true' to disable X/Twitter scraping (headless browser) in the agent.
# DISABLE_X_SCRAPING=true
